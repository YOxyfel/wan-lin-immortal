{
  "name": "wuhen-xuan-heaven-defying",
  "version": "1.0.0",
  "private": true,
  "description": "Wuhen & Xuan: Heaven Defying — a dark xianxia cultivation game website.",
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i ./assets/tailwind.src.css -o ./assets/tailwind.css --minify",
    "css:watch": "tailwindcss -i ./assets/tailwind.src.css -o ./assets/tailwind.css --watch",
    "dev": "npm run css && vite",
